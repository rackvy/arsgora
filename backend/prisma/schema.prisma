generator client {
  provider = "prisma-client-js"
  // ВАЖНО: никакого output тут не должно быть
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum CodeStatus {
  AVAILABLE // загружен из Excel, ещё никому не продан
  SOLD // привязан к пользователю, но не использован
  USED // уже отмечен пользователем как использованный
  BLOCKED // заблокирован админом
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
}

/**
 * Пользователи
 */
model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  emailVerifiedAt DateTime?
  phone           String?   @unique
  passwordHash    String

  emailLoginCode          String?
  emailLoginCodeExpiresAt DateTime?

  role      UserRole @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  codes           LiftCode[]
  orders          Order[]
  uploadedBatches CodeBatch[] @relation("UserUploadedBatches")
  Payment         Payment[]
}

/**
 * Загруженные из Excel батчи кодов
 */
model CodeBatch {
  id           Int      @id @default(autoincrement())
  name         String
  uploadedBy   User?    @relation("UserUploadedBatches", fields: [uploadedById], references: [id])
  uploadedById Int?
  uploadedAt   DateTime @default(now())

  codes LiftCode[]
}

/**
 * Коды на подъёмник
 */
model LiftCode {
  id     Int        @id @default(autoincrement())
  code   String     @unique
  status CodeStatus @default(AVAILABLE)

  owner   User? @relation(fields: [ownerId], references: [id])
  ownerId Int?

  batch   CodeBatch? @relation(fields: [batchId], references: [id])
  batchId Int?

  price       Int? // цена в копейках, если понадобится
  purchasedAt DateTime?
  usedAt      DateTime? // заполняется, когда пользователь отмечает код использованным

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItem OrderItem?
}

/**
 * Заказ (под эквайринг на будущее)
 */
model Order {
  id          Int         @id @default(autoincrement())
  user        User        @relation(fields: [userId], references: [id])
  userId      Int
  totalAmount Int
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items OrderItem[]
}

/**
 * Позиция заказа: конкретный код
 */
model OrderItem {
  id      Int   @id @default(autoincrement())
  order   Order @relation(fields: [orderId], references: [id])
  orderId Int

  code   LiftCode @relation(fields: [codeId], references: [id])
  codeId Int      @unique

  price Int
}

model Payment {
  id     Int  @id @default(autoincrement())
  user   User @relation(fields: [userId], references: [id])
  userId Int

  provider   String // "yookassa"
  providerId String // payment.id в ЮKassa
  amount     Int // сумма в копейках / центах
  currency   String // "RUB"
  status     String // "pending" | "succeeded" | "canceled" | ...
  codesCount Int // сколько кодов покупает
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
